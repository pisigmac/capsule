# Capsule Configuration
# Local default: SQLite. Docker Compose uses Postgres instead.
CAPSULE_DATABASE_URL=sqlite:///capsule.db
# CAPSULE_DATABASE_URL=postgresql+psycopg://capsule:capsule@127.0.0.1:5432/capsule
CAPSULES_DIR=./capsules
CAPSULES_SHARED_DIR=./capsules/shared
CAPSULES_ARCHIVED_DIR=./capsules/archived

# API
API_HOST=127.0.0.1
API_PORT=9100
CAPSULE_WATCH=true
CAPSULE_RECONCILE=true
CAPSULE_DB_POOL_SIZE=5
CAPSULE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# CAPSULE_API_TOKEN=

# Search / retention
SEARCH_LIMIT=50
AUTO_ARCHIVE_DAYS=90

LOG_LEVEL=INFO
